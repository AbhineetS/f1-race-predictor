@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Titillium+Web:wght@400;600;700;900&display=swap');

:root {
  --bg-dark: #05070d;
  --bg-sidebar: #0a0d14;
  --bg-card: rgba(17, 24, 39, 0.6);
  --bg-card-hover: rgba(25, 35, 55, 0.8);
  --border-glass: rgba(255, 255, 255, 0.08);
  --border-light: rgba(255, 255, 255, 0.04);
  
  --f1-red: #e10600;
  --f1-red-glow: rgba(225, 6, 0, 0.15);
  
  --text-main: #f3f4f6;
  --text-muted: #9ca3af;
  --text-dim: #6b7280;
  
  --success: #10b981;
  --success-glow: rgba(16, 185, 129, 0.2);
  
  --gold: #ffd700;
  --silver: #c0c0c0;
  --bronze: #cd7f32;
  
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-f1: 'Titillium Web', sans-serif;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: var(--bg-dark);
  background-image: 
    radial-gradient(circle at top right, var(--f1-red-glow), transparent 30%),
    radial-gradient(circle at bottom right, rgba(255, 255, 255, 0.02), transparent 40%);
  color: var(--text-main);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

.app {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

/* --- SIDEBAR --- */
.sidebar {
  width: 250px;
  background-color: var(--bg-sidebar);
  border-right: 1px solid var(--border-glass);
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  height: 100%;
  flex-shrink: 0;
  z-index: 10;
}

.logo-container {
  padding: 0 12px;
  margin-bottom: 40px;
}

.f1-logo {
  width: 90px;
  height: auto;
}

.nav-menu {
  flex: 1;
}

.nav-menu ul {
  list-style: none;
}

.nav-menu li {
  padding: 12px 16px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s ease;
  color: var(--text-muted);
  font-weight: 500;
  font-size: 0.9rem;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 4px;
}

.nav-menu li:hover {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-main);
}

.nav-menu li.active {
  background: linear-gradient(90deg, rgba(225, 6, 0, 0.12) 0%, transparent 100%);
  color: var(--text-main);
  border-left: 3px solid var(--f1-red);
}

.nav-menu .icon {
  font-size: 1.1rem;
  opacity: 0.8;
}

/* SESSION CARD */
.session-card {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--border-glass);
  border-radius: 10px;
  padding: 16px;
  margin-bottom: 20px;
}

.session-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.session-title {
  font-family: var(--font-f1);
  font-weight: 600;
  font-size: 0.8rem;
  color: var(--text-muted);
  text-transform: uppercase;
}

.live-badge {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--success);
  font-size: 0.75rem;
  font-weight: 700;
  background: var(--success-glow);
  padding: 2px 8px;
  border-radius: 4px;
}

.dot.pulse {
  width: 6px;
  height: 6px;
  background-color: var(--success);
  border-radius: 50%;
  animation: pulse-green 1.5s infinite;
}

@keyframes pulse-green {
  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
  70% { box-shadow: 0 0 0 4px rgba(16, 185, 129, 0); }
  100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
}

.gp-title {
  font-weight: 700;
  font-size: 1rem;
  margin-bottom: 2px;
}

.circuit-name {
  color: var(--text-muted);
  font-size: 0.8rem;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.circuit-name::before {
  content: "🇨🇦";
  font-size: 0.9rem;
}

.session-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.stat-item:first-child {
  grid-column: 1 / -1;
  margin-bottom: 4px;
}

.stat-label {
  color: var(--text-dim);
  font-size: 0.7rem;
  text-transform: uppercase;
  font-weight: 600;
}

.stat-val {
  font-size: 0.85rem;
  font-weight: 600;
}

.copyright {
  font-size: 0.7rem;
  color: var(--text-dim);
  text-align: left;
  line-height: 1.4;
  padding-left: 4px;
}

/* --- MAIN CONTENT --- */
.main {
  flex: 1;
  padding: 32px 40px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* HEADER */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 32px;
  flex-shrink: 0;
}

.header-left h1 {
  font-family: var(--font-f1);
  font-size: 2.2rem;
  font-weight: 700;
  letter-spacing: -0.5px;
  margin-bottom: 4px;
}

.f1-red-text {
  color: var(--f1-red);
}

.header-left p {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16px;
}

.auto-refresh-dropdown {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 0.85rem;
  color: var(--text-main);
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  backdrop-filter: blur(10px);
}

.status-on {
  color: var(--success);
  font-weight: 600;
}

.chevron {
  font-size: 0.6rem;
  color: var(--text-muted);
  margin-left: 4px;
}

.last-updated {
  color: var(--text-muted);
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* STAT CARDS ROW */
.stat-cards-row {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 16px;
  margin-bottom: 24px;
  flex-shrink: 0;
}

.glass-card {
  background: var(--bg-card);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid var(--border-glass);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.stat-card {
  border-radius: 10px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 16px;
  transition: all 0.2s ease;
}

.stat-card:hover {
  background: var(--bg-card-hover);
  border-color: rgba(255, 255, 255, 0.12);
  transform: translateY(-2px);
}

.card-icon {
  font-size: 1.5rem;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--border-light);
}

.red-icon { color: var(--f1-red); }
.purple-icon { color: #a855f7; }
.yellow-icon { color: #eab308; }
.blue-icon { color: #3b82f6; }
.green-icon { color: #10b981; }

.card-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.card-label {
  color: var(--text-muted);
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.card-value {
  font-size: 1.2rem;
  font-weight: 700;
  font-family: var(--font-f1);
}

.red-text {
  color: var(--f1-red);
}

/* TABLE */
.table-container {
  flex: 1;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.table-wrapper {
  overflow-y: auto;
  flex: 1;
}

table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

thead th {
  position: sticky;
  top: 0;
  background: rgba(10, 13, 20, 0.95);
  backdrop-filter: blur(8px);
  color: var(--text-dim);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 16px 20px;
  font-weight: 600;
  border-bottom: 1px solid var(--border-glass);
  z-index: 10;
}

tbody tr {
  border-bottom: 1px solid var(--border-light);
  transition: all 0.2s ease;
}

tbody tr:nth-child(even) {
  background-color: rgba(255, 255, 255, 0.01);
}

tbody tr:hover {
  background-color: rgba(255, 255, 255, 0.04);
  box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.02);
}

td {
  padding: 14px 20px;
  font-size: 0.9rem;
  vertical-align: middle;
}

.col-pos { width: 60px; text-align: center; }
.col-num { width: 80px; font-family: var(--font-f1); font-weight: 700; }
.col-driver { width: 250px; font-weight: 600; text-transform: uppercase; }
.col-team { width: 180px; color: var(--text-muted); font-size: 0.85rem; }
.col-car { width: 120px; color: var(--text-dim); font-size: 0.85rem; }
.col-gap { width: 120px; font-family: var(--font-f1); }
.col-last { width: 120px; color: #a855f7; font-family: var(--font-f1); }

.pos-number {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 4px;
  font-weight: 700;
  font-family: var(--font-f1);
  margin: 0 auto;
}

.pos-1 { color: var(--gold); background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.2); }
.pos-2 { color: var(--silver); background: rgba(192, 192, 192, 0.1); border: 1px solid rgba(192, 192, 192, 0.2); }
.pos-3 { color: var(--bronze); background: rgba(205, 127, 50, 0.1); border: 1px solid rgba(205, 127, 50, 0.2); }

.driver-name-wrapper {
  display: flex;
  align-items: center;
  gap: 12px;
}

.team-color-indicator {
  width: 3px;
  height: 18px;
  border-radius: 2px;
  flex-shrink: 0;
}

.team-cell {
  display: flex;
  align-items: center;
  gap: 8px;
}

.team-logo {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  display: inline-block;
  opacity: 0.8;
}

.empty-state {
  text-align: center;
  padding: 60px;
  color: var(--text-muted);
}

.table-footer {
  padding: 12px 20px;
  background: rgba(0, 0, 0, 0.2);
  border-top: 1px solid var(--border-glass);
  font-size: 0.75rem;
  color: var(--text-dim);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* SCROLLBAR */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.25);
}

/* RESPONSIVE */
@media (max-width: 1400px) {
  .col-car { display: none; }
}

@media (max-width: 1100px) {
  .stat-cards-row {
    grid-template-columns: repeat(3, 1fr);
  }
  .col-last { display: none; }
}

@media (max-width: 900px) {
  .app {
    flex-direction: column;
    overflow: auto;
  }
  .sidebar {
    width: 100%;
    height: auto;
    border-right: none;
    border-bottom: 1px solid var(--border-glass);
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-start;
  }
  .logo-container { margin-bottom: 0; }
  .nav-menu { width: 100%; }
  .nav-menu ul { display: flex; flex-wrap: wrap; gap: 8px; }
  .nav-menu li { margin-bottom: 0; }
  .session-card { width: 100%; margin-bottom: 0; }
  
  .main {
    padding: 20px;
    overflow: visible;
  }
  .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .stat-cards-row {
    grid-template-columns: repeat(2, 1fr);
  }
  .table-container {
    overflow: visible;
  }
  .table-wrapper {
    overflow-x: auto;
  }
}

@media (max-width: 600px) {
  .stat-cards-row { grid-template-columns: 1fr; }
  .col-team, .col-gap { display: none; }
}